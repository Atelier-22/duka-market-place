NODE_ENV=development
PORT=4000

# Production: the Neon connection string with sslmode=require
DATABASE_URL=postgres://duka:duka@localhost:5432/duka

# Production: at least 32 random characters each, never reuse across environments
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Production: the exact frontend origins, comma separated, no trailing slash
# CORS_ORIGIN=https://www.dukashoppers.com,https://dukashoppers.com
CORS_ORIGIN=http://localhost:5173

# Production: the public https address of this API, used to build upload URLs
# PUBLIC_URL=https://api.dukashoppers.com
PUBLIC_URL=http://localhost:4000

# Set to false only if the API is reached directly, not through a load balancer or platform proxy
TRUST_PROXY=true

STORAGE_DRIVER=database
UPLOAD_DIR=./uploads

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=

PAYMENT_DRIVER=manual

OCR_DRIVER=manual
ANTHROPIC_API_KEY=

# Production: at least 32 random characters; hashes national ID numbers
ID_HASH_SECRET=change_me_id_hash_secret

PLATFORM_FEE_PERCENTAGE=10
DEFAULT_DELIVERY_FEE_UGX=5000
