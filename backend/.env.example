NODE_ENV=development
PORT=4000

# postgres://user:password@host:5432/dbname
DATABASE_URL=postgres://duka:duka@localhost:5432/duka

JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Comma-separated list of allowed browser origins. Include every hostname the
# app is served from — the apex, its www, and any old host still live while DNS
# moves (e.g. https://dukashoppers.com,https://www.dukashoppers.com).
CORS_ORIGIN=http://localhost:5173

# Storage abstraction — "local" writes to backend/uploads in dev.
# Swap to "s3" once real credentials exist (see services/storage.service.ts).
# database = bytes in Postgres, which survives a deploy. A container disk does not.
#
# "local" is IGNORED when NODE_ENV=production and the database driver is used
# instead, with a warning. A container disk is wiped on restart and is not
# shared between instances, so photos sent in chat survive a few minutes and
# then 404 forever. Check which driver is really running with GET /health.
STORAGE_DRIVER=database
UPLOAD_DIR=./uploads

# Cloudflare R2 (or any S3-compatible bucket) — used when STORAGE_DRIVER=r2.
# Durable like the database driver, without image bytes competing with the
# orders for space in Postgres. Switching needs no migration: a key that is not
# in the bucket is looked for in uploaded_files before it is called missing, so
# photos uploaded before the switch keep resolving.
# Boot fails immediately if STORAGE_DRIVER=r2 and any of these are missing.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Only for a non-Cloudflare S3 endpoint; derived from R2_ACCOUNT_ID otherwise.
R2_ENDPOINT=

# Payment abstraction — "manual" in MVP (see services/payment.service.ts)
PAYMENT_DRIVER=manual

# Reading fields off an identity document (see services/ocr.service.ts).
# "manual" = no automated reading; submissions reach a reviewer with nothing
# pre-filled, which is a complete workflow, not a degraded one.
# "claude" = Claude vision pre-fills the fields and runs the auto-reject
# checks. Boot fails if it is set without ANTHROPIC_API_KEY.
# Neither can approve anyone — only a reviewer can. Format checks cannot
# prove a document is genuine or that it belongs to the person holding it.
OCR_DRIVER=manual
ANTHROPIC_API_KEY=

# Keys the hash of every ID number in identity_registry, which is how a banned
# user re-registering with the same document is caught after their account is
# gone. An UNKEYED hash of a national ID number is reversible by anyone willing
# to enumerate the format, so this secret is what stops the registry being a
# list of real ID numbers. REQUIRED in production.
# Changing it makes every stored hash unmatchable and silently turns duplicate
# detection off — rotate it only with a plan to rebuild the registry.
ID_HASH_SECRET=change_me_id_hash_secret

PLATFORM_FEE_PERCENTAGE=10
DEFAULT_DELIVERY_FEE_UGX=5000

# Public origin of THIS API. Uploaded files are stored as absolute URLs built
# from it, so it must be the address the browser can reach (e.g.
# https://duka-backend-9098.onrender.com). Defaults to http://localhost:4000.
PUBLIC_URL=http://localhost:4000
